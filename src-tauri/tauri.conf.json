{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoChat",
  "version": "0.1.3",
  "identifier": "id.or.oo.gc",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "$CONFIG/**"]
      },
      "freezePrototype": true
    },
    "trayIcon": {
      "iconPath": "icons/default/normal.png",
      "iconAsTemplate": true,
      "id": "main"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Network",
    "shortDescription": "Google Chat Desktop Client",
    "longDescription": "A lightweight desktop client for Google Chat built with Tauri v2",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  },
  "plugins": {}
}

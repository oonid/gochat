{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gochat",
  "version": "0.1.2",
  "identifier": "id.or.oo.gc",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "$CONFIG/**"]
      },
      "freezePrototype": true
    },
    "trayIcon": {
      "iconPath": "icons/default/normal.png",
      "iconAsTemplate": true,
      "id": "main"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["icons/default/*", "icons/colored/*", "icons/mono/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Google Chat Desktop Client",
    "longDescription": "A lightweight desktop client for Google Chat built with Tauri v2",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      },
      "rpm": {},
      "appimage": {}
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/icon.ico",
        "installMode": "currentUser"
      },
      "wix": {
        "upgradeCode": "E05837B2-C0F8-4E90-BCCE-D3C860CC9002"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/oonid/gochat/releases/latest/download/{{target}}-{{arch}}.json"],
      "pubkey": "RWRoQDbnXS+chrbwZ6HsVkQ6LTENIOJFsaFhOaKfkvnrGu1FMs9PChy2"
    },
    "deep-link": {
      "schemes": ["gchat"]
    }
  }
}
